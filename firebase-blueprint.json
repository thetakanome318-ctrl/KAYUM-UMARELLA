        "penyulang": { "type": "string" },
        "section": { "type": "string" },
        "tanggal": { "type": "string" },
        "targetKms": { "type": "number" },
        "realisasiKms": { "type": "number" },
        "realisasiGawang": { "type": "number" },
        "jumlahTemuan": { "type": "number" },
        "realisasiTemuan": { "type": "number" },
        "luarTemuan": { "type": "number" },
        "realisasiLuarTemuan": { "type": "number" },
        "catatan": { "type": "string" },
        "perluPadam": { "type": "boolean" },
        "jumlahPerluPadam": { "type": "number" },
        "tidakAdaIzin": { "type": "boolean" },
        "jumlahTidakAdaIzin": { "type": "number" },
        "pohonBesar": { "type": "boolean" },
        "jumlahPohonBesar": { "type": "number" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "lokasi": { "type": "string" },
