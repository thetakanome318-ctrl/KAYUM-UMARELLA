{
  "entities": {
    "records": {
      "title": "ROW Monitoring Record",
      "description": "Records of ROW tree trimming, KMS targets, findings, and issues per section/feeder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bulan": { "type": "string" },
        "bulanKe": { "type": "number" },
        "tahun": { "type": "number" },
        "penyulang": { "type": "string" },
        "section": { "type": "string" },
        "tanggal": { "type": "string" },
        "targetKms": { "type": "number" },
        "realisasiKms": { "type": "number" },
        "realisasiGawang": { "type": "number" },
        "jumlahTemuan": { "type": "number" },
        "realisasiTemuan": { "type": "number" },
        "catatan": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "section", "penyulang"]
    },
    "monthlyTargets": {
      "title": "Monthly Targets",
      "description": "Target KMS and Target Gawang set for specific year and month.",
      "type": "object",
      "properties": {
        "bulanKey": { "type": "string" },
        "tahun": { "type": "number" },
        "bulanKe": { "type": "number" },
        "targetKms": { "type": "number" },
        "targetGawang": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["bulanKey"]
    },
    "penyulang": {
      "title": "Penyulang Master Data",
      "description": "Master list of electrical feeders (penyulang).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "kode": { "type": "string" },
        "panjangJaringan": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "nama"]
    },
    "masterSection": {
      "title": "Master Section Data",
      "description": "Master list of sections for feeders.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "penyulangId": { "type": "string" },
        "namaSection": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "namaSection"]
    },
    "gangguanPangkal": {
      "title": "Gangguan Pangkal Record",
      "description": "Records of substation feeder trip/outages (Gangguan Pangkal).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tanggal": { "type": "string" },
        "penyulang": { "type": "string" },
        "jamKeluar": { "type": "string" },
        "jamMasuk": { "type": "string" },
        "durasi": { "type": "string" },
        "kodeGangguan": { "type": "string" },
        "penyebab": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "penyulang"]
    },
    "pemeliharaanRecords": {
      "title": "Pemeliharaan Record",
      "description": "Records of feeder maintenance schedules and executions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tanggal": { "type": "string" },
        "penyulang": { "type": "string" },
        "jenisPemeliharaan": { "type": "string" },
        "keterangan": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "penyulang"]
    }
  },
  "firestore": {
    "records": {
      "schema": { "$ref": "#/entities/records" },
      "description": "Collection of ROW monitoring records."
    },
    "monthlyTargets": {
      "schema": { "$ref": "#/entities/monthlyTargets" },
      "description": "Collection of monthly target items."
    },
    "penyulang": {
      "schema": { "$ref": "#/entities/penyulang" },
      "description": "Collection of feeder master data."
    },
    "masterSection": {
      "schema": { "$ref": "#/entities/masterSection" },
      "description": "Collection of section master data."
    },
    "gangguanPangkal": {
      "schema": { "$ref": "#/entities/gangguanPangkal" },
      "description": "Collection of substation feeder trip logs."
    },
    "pemeliharaanRecords": {
      "schema": { "$ref": "#/entities/pemeliharaanRecords" },
      "description": "Collection of feeder maintenance logs."
    }
  }
}
